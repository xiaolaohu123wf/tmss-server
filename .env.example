# ── TCP 原始收发调试（排错时开启；高流量会刷屏）──
TCP_RAW_PRINT=false
# 为 true 时 /api/admin/tcp-messages 对非本机也免登录（Docker 端口映射等；勿在生产开启）
TCP_MESSAGES_PUBLIC=false

# ── 服务端口 ──────────────────────────────────────────
TCP_PORT=8901
HTTP_PORT=8900

# ── 数据库（必填）────────────────────────────────────
# 使用 docker compose --profile local-db 时，从宿主机连接请改为 ...@localhost:5433/...
DATABASE_URL=postgresql://tmss:tmss@localhost:5432/tmss_db
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ── Redis（必填）──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 业务参数（兜底，运行时以 business_config 表为准）──
PARK_THRESHOLD_MIN=10
ALERT_COOLDOWN_S=10
HB_TIMEOUT_S=90

# ── 外部服务 ──────────────────────────────────────────
WEATHER_API_URL=https://wttr.in

# ── 安全（必填）──────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
BCRYPT_COST=12

# ── 日志级别：DEBUG / INFO / WARNING / ERROR ──────────
LOG_LEVEL=INFO
